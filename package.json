{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in tmux",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "format:check": "biome format agents pi-extension test",
    "lint": "biome lint agents pi-extension test",
    "build": "tsc --noEmit --noCheck",
    "test": "node --test test/test.ts",
    "test:coverage": "c8 --all --include='pi-extension/**/*.ts' --reporter=text --reporter=lcov node --test test/test.ts",
    "test:loadout:cli": "node --test test/integration/explicit-loadout-cli.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "typescript": "^7.0.2"
  }
}
